<?xml version="1.0" encoding="UTF-8"?>
<database defaultIdMethod="native" name="TheliaMain"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="../../../../vendor/thelia/propel/resources/xsd/database.xsd" >
    <vendor type="mysql">
        <parameter name="Engine" value="InnoDB"/>
        <parameter name="Charset" value="utf8mb4"/>
        <parameter name="Collate" value="utf8mb4_general_ci"/>
        <parameter name="RowFormat" value="DYNAMIC"/>
    </vendor>
    <table name="csv_importer_profile" namespace="CsvImporter\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER" />
        <column name="name" required="true" type="VARCHAR" size="100" />
        <column name="delimiter" type="VARCHAR" size="8" />
        <column name="encoding" type="VARCHAR" size="20" />
        <column name="decimal_separator" type="VARCHAR" size="1" />
        <column name="mapping" required="true" type="LONGVARCHAR" />
        <unique name="csv_importer_profile_name_unique">
            <unique-column name="name" />
        </unique>
        <behavior name="timestampable" />
    </table>

    <table name="csv_importer_job" namespace="CsvImporter\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER" />
        <column name="profile_id" type="INTEGER" />
        <column name="admin_id" type="INTEGER" />
        <column name="status" required="true" type="VARCHAR" size="16" />
        <column name="mode" required="true" type="VARCHAR" size="16" />
        <column name="dry_run" defaultValue="0" required="true" type="TINYINT" />
        <column name="source_name" required="true" type="VARCHAR" size="255" />
        <column name="source_path" required="true" type="VARCHAR" size="255" />
        <column name="total_rows" defaultValue="0" required="true" type="INTEGER" />
        <column name="processed_rows" defaultValue="0" required="true" type="INTEGER" />
        <column name="created_rows" defaultValue="0" required="true" type="INTEGER" />
        <column name="updated_rows" defaultValue="0" required="true" type="INTEGER" />
        <column name="unchanged_rows" defaultValue="0" required="true" type="INTEGER" />
        <column name="skipped_rows" defaultValue="0" required="true" type="INTEGER" />
        <column name="failed_rows" defaultValue="0" required="true" type="INTEGER" />
        <column name="started_at" type="TIMESTAMP" />
        <column name="finished_at" type="TIMESTAMP" />
        <column name="error" type="LONGVARCHAR" />
        <foreign-key foreignTable="csv_importer_profile" name="fk_csv_importer_job_profile" onDelete="SET NULL" onUpdate="CASCADE">
            <reference foreign="id" local="profile_id" />
        </foreign-key>
        <index name="idx_csv_importer_job_status">
            <index-column name="status" />
        </index>
        <behavior name="timestampable" />
    </table>

    <table name="csv_importer_job_row" namespace="CsvImporter\Model">
        <column autoIncrement="true" name="id" primaryKey="true" required="true" type="INTEGER" />
        <column name="job_id" required="true" type="INTEGER" />
        <column name="line_number" required="true" type="INTEGER" />
        <column name="outcome" required="true" type="VARCHAR" size="16" />
        <column name="reference" type="VARCHAR" size="255" />
        <column name="message" type="LONGVARCHAR" />
        <foreign-key foreignTable="csv_importer_job" name="fk_csv_importer_job_row_job" onDelete="CASCADE" onUpdate="CASCADE">
            <reference foreign="id" local="job_id" />
        </foreign-key>
        <index name="idx_csv_importer_job_row_outcome">
            <index-column name="job_id" />
            <index-column name="outcome" />
        </index>
    </table>

    <external-schema filename="local/config/schema.xml" referenceOnly="true" />
</database>
